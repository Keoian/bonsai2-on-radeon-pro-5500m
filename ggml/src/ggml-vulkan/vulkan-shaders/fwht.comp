#version 450

#extension GL_EXT_control_flow_attributes : require
#ifdef FWHT_F16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
#if !defined(FWHT_SHMEM) || defined(FWHT_WIDE)
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#endif
#ifdef FWHT_Q8
// also writes the result as block_q8_1_x4, the same bytes as quantize_q8_1.comp, for the mat-vec that reads it
#extension GL_KHR_shader_subgroup_clustered : require
#include "types.glsl"
#endif

layout(constant_id = 0) const uint BLOCK_SIZE = 32;
layout(constant_id = 1) const uint N = 128;
layout(constant_id = 2) const uint ROWS = 4;
// FWHT_WIDE: one row per workgroup of BLOCK_SIZE invocations in full subgroups of SG_SIZE
layout(constant_id = 3) const uint SG_SIZE = 32;

layout(local_size_x_id = 0, local_size_y_id = 2, local_size_z = 1) in;

layout(push_constant) uniform parameter
{
    uint n_rows;
    uint src_offset;
#ifdef FWHT_SIGNED
    uint signs_offset;
    uint signs_ne;
#endif
    uint dst_offset;
    float scale;
#ifdef FWHT_GLU
    uint glu_offset;
#endif
};

layout(binding = 0, std430) readonly buffer A {
#ifdef FWHT_F16
    float16_t data_a[];
#else
    float data_a[];
#endif
};
layout(binding = 1, std430) writeonly buffer D { float data_d[]; };
#ifdef FWHT_SIGNED
layout(binding = 2, std430) readonly buffer S { float data_s[]; };
#endif
#ifdef FWHT_Q8
#ifdef FWHT_SIGNED
layout(binding = 3, std430) writeonly buffer Q { block_q8_1_x4 data_q[]; };
#else
layout(binding = 2, std430) writeonly buffer Q { block_q8_1_x4 data_q[]; };
#endif
#endif
#ifdef FWHT_GLU
// FWHT_GLU (with FWHT_SIGNED): the row is swiglu(data_a, data_u) = silu(gate) * up, computed on load
#ifdef FWHT_Q8
layout(binding = 4, std430) readonly buffer U { float data_u[]; };
#else
layout(binding = 3, std430) readonly buffer U { float data_u[]; };
#endif
#endif

const uint EL_W = N / BLOCK_SIZE;

#ifdef FWHT_SHMEM
shared float shmem[ROWS * N];
#endif

void main() {
#if defined(FWHT_WIDE)
    // element index from the subgroup and lane, so the shuffles below pair the right elements
    const uint tid = gl_SubgroupID * SG_SIZE + gl_SubgroupInvocationID;
    const uint shmem_base = 0;
    const uint row_id = 0;
#elif defined(FWHT_SHMEM)
    const uint tid = gl_LocalInvocationID.x;
    const uint shmem_base = gl_LocalInvocationID.y * N;
    const uint row_id = gl_LocalInvocationID.y;
#else
    const uint tid = gl_SubgroupInvocationID;
    const uint row_id = gl_SubgroupID;
#endif

    for (uint base_row = gl_WorkGroupID.x * gl_WorkGroupSize.y;
            base_row < n_rows;
            base_row += gl_NumWorkGroups.x * gl_WorkGroupSize.y) {
        const uint row = base_row + row_id;
        const uint row_offset = row * N;

#ifndef FWHT_SHMEM
        if (row >= n_rows) {
            continue;
        }
#endif

        float reg[EL_W];

        [[unroll]]
        for (uint i = 0; i < EL_W; ++i) {
#if defined(FWHT_GLU)
            if (row < n_rows) {
                const float g = float(data_a[src_offset + row_offset + i * BLOCK_SIZE + tid]);
                const float x = g / (1.0f + exp(-g)) * data_u[glu_offset + row_offset + i * BLOCK_SIZE + tid];
                reg[i] = x * data_s[signs_offset + (row_offset % signs_ne) + i * BLOCK_SIZE + tid] * scale;
            } else {
                reg[i] = 0.0;
            }
#elif defined(FWHT_SIGNED)
            reg[i] = row < n_rows ? float(data_a[src_offset + row_offset + i * BLOCK_SIZE + tid]) * data_s[signs_offset + (row_offset % signs_ne) + i * BLOCK_SIZE + tid] * scale : 0.0;
#else
            reg[i] = row < n_rows ? float(data_a[src_offset + row_offset + i * BLOCK_SIZE + tid]) * scale : 0.0;
#endif
        }

#ifdef FWHT_SHMEM
#ifdef FWHT_WIDE
        // pairs inside a subgroup exchange by shuffle, without a barrier
        [[unroll]]
        for (uint h = 1; h < SG_SIZE; h <<= 1) {
            [[unroll]]
            for (uint j = 0; j < EL_W; ++j) {
                const float val = reg[j];
                const float val2 = subgroupShuffleXor(val, h);
                reg[j] = (tid & h) == 0 ? val + val2 : val2 - val;
            }
        }
        const uint h0 = SG_SIZE;
#else
        const uint h0 = 1;
#endif
        [[unroll]]
        for (uint h = h0; h < BLOCK_SIZE; h <<= 1) {
            [[unroll]]
            for (uint i = 0; i < EL_W; ++i) {
                shmem[shmem_base + i * BLOCK_SIZE + tid] = reg[i];
            }
            barrier();
            [[unroll]]
            for (uint j = 0; j < EL_W; ++j) {
                const float val = reg[j];
                const float other = shmem[shmem_base + j * BLOCK_SIZE + (tid ^ h)];
                reg[j] = (tid & h) == 0 ? val + other : other - val;
            }
            barrier();
        }
#else
        [[unroll]]
        for (uint h = 1; h < BLOCK_SIZE; h <<= 1) {
            [[unroll]]
            for (uint j = 0; j < EL_W; ++j) {
                const float val = reg[j];
                const float val2 = subgroupShuffleXor(val, h);
                reg[j] = (tid & h) == 0 ? val + val2 : val2 - val;
            }
        }
#endif

        [[unroll]]
        for (uint h = BLOCK_SIZE; h < N; h <<= 1) {
            const uint step = h / BLOCK_SIZE;
            [[unroll]]
            for (uint j = 0; j < EL_W; j += 2 * step) {
                [[unroll]]
                for (uint k = 0; k < step; ++k) {
                    const float x = reg[j + k];
                    const float y = reg[j + k + step];
                    reg[j + k] = x + y;
                    reg[j + k + step] = x - y;
                }
            }
        }

#ifdef FWHT_SHMEM
        if (row < n_rows) {
#endif
            [[unroll]]
            for (uint i = 0; i < EL_W; ++i) {
                data_d[dst_offset + row_offset + i * BLOCK_SIZE + tid] = reg[i];
            }
#ifdef FWHT_Q8
            // a q8_1 block is 32 consecutive elements, so 32 consecutive invocations of one subgroup (SG_SIZE >= 32)
            [[unroll]]
            for (uint i = 0; i < EL_W; ++i) {
                const uint e = row_offset + i * BLOCK_SIZE + tid;
                const float amax = subgroupClusteredMax(abs(reg[i]), 32);
                const float d = amax / 127.0;
                const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
                const float q = round(reg[i] * d_inv);
                const float sum = subgroupClusteredAdd(q, 32);
                const uint packed = subgroupClusteredOr((uint(int(q)) & 0xFFu) << (8u * (tid % 4u)), 4);
                const uint ib = e / 32u;
                if (tid % 4u == 0u) {
                    data_q[ib / 4u].qs[(ib % 4u) * 8u + (e % 32u) / 4u] = int32_t(packed);
                }
                if (tid % 32u == 0u) {
                    data_q[ib / 4u].ds[ib % 4u] = f16vec2(vec2(d, sum * d));
                }
            }
#endif
#ifdef FWHT_SHMEM
        }
        barrier();
#endif
    }
}
