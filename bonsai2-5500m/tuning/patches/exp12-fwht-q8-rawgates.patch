+// (optional sign flip) + FWHT-hint matmul feeding a PTQ1_0 mat-vec: on Vulkan the FWHT writes the q8_1 copy that the
+// mat-vec consumes instead of quantizing its input again
+struct test_fwht_ptq1_mv : public test_case {
+    const int64_t width;
+    const int64_t n_tokens;
+    const bool    signs;
+
+    test_fwht_ptq1_mv(int64_t width = 5120, int64_t n_tokens = 1, bool signs = true)
+        : width(width), n_tokens(n_tokens), signs(signs) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(width, n_tokens, signs);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FWHT_PTQ1_MV";
+    }
+
+    // same tolerance as test_mul_mat: the mat-vec quantizes its activations to q8_1
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t blk = 1024;
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, blk, blk);
+        ggml_set_name(a, "a");
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, width, n_tokens);
+        ggml_set_name(x, "x");
+        ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_PTQ1_0, width, 67);
+        ggml_set_name(w, "w");
+
+        ggml_tensor * cur = x;
+        if (signs) {
+            ggml_tensor * s = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, width);
+            ggml_set_name(s, "s");
+            cur = ggml_mul(ctx, cur, s);
+        }
+        cur = ggml_reshape_2d(ctx, cur, blk, width / blk * n_tokens);
+        cur = ggml_mul_mat(ctx, a, cur);
+        ggml_mul_mat_set_hint(cur, GGML_HINT_SRC0_IS_HADAMARD);
+        cur = ggml_reshape_2d(ctx, cur, width, n_tokens);
+        ggml_tensor * out = ggml_mul_mat(ctx, w, cur);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "a") == 0) {
+                const int64_t n = t->ne[0];
+                std::vector<float> data(n * n);
+                const float scale = 1.0f / sqrtf((float) n);
+                for (int64_t r = 0; r < n; r++) {
+                    for (int64_t i = 0; i < n; i++) {
+                        int64_t v = r & i; int pop = 0;
+                        while (v) { pop += (int) (v & 1); v >>= 1; }
+                        data[r * n + i] = (pop % 2 == 0) ? scale : -scale;
+                    }
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+            } else if (strcmp(t->name, "s") == 0) {
+                std::vector<float> data(ggml_nelements(t));
+                for (size_t i = 0; i < data.size(); i++) {
+                    data[i] = (i % 3 == 0) ? -1.0f : 1.0f;
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
