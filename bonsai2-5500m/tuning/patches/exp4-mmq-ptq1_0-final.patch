+#if defined(DATA_A_PTQ1_0)
+#include "ptq1_0.glsl"
+
+// dword view of the 28-byte (7-dword) PTQ1_0 blocks
+layout (binding = 0) readonly buffer A_PTQ1_0_U32 { uint32_t data_a_u32[]; };
+
+// PTQ1_0 (128 ternary weights per block, see ptq1_0.glsl for the element order): each 32-element unit ib is a
+// quarter block; iqs covers 4 consecutive elements. Trits (0..2) are stored in shared memory; the ternary -1
+// offset is applied with the q8_1 block sum, as for Q2_0: d_a * (sum_e t_e * q8_e * d_b - s_b).
+void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
+    const uint block_idx = ib >> 2u;
+    const uint e0 = ((ib & 3u) << 5u) + (iqs << 2u);
+
+    uint packed;
+    if (e0 < 120u) {
+        // qs regions: the 4 elements are one aligned dword (bytes e0 & 15, or 16 + ((e0 - 80) & 7)) at one level
+        const uint byte_off = e0 < 80u ? (e0 & 15u) : 16u + ((e0 - 80u) & 7u);
+        const uint n        = e0 < 80u ? (e0 >> 4u) : ((e0 - 80u) >> 3u);
+        const uint w  = data_a_u32[block_idx * 7u + (byte_off >> 2u)];
+        const uint p3 = POW3_MOD256[n];
+        // two bytes per 16-bit lane: v = b * 3^n mod 256, trit = (v * 3) >> 8
+        const uint lo = ((w & 0x00FF00FFu) * p3) & 0x00FF00FFu;
+        const uint hi = (((w >> 8u) & 0x00FF00FFu) * p3) & 0x00FF00FFu;
+        packed = (((lo * 3u) >> 8u) & 0x00FF00FFu) | ((((hi * 3u) >> 8u) & 0x00FF00FFu) << 8u);
+    } else {
+        // qh: elements 120 + 2n + h come from qh[h] at level n
+        packed = 0u;
+        [[unroll]] for (uint k = 0; k < 4; ++k) {
+            const uint t = e0 - 120u + k;
+            const uint b = uint(data_a[block_idx].qh[t & 1u]);
+            const uint v = (b * POW3_MOD256[t >> 1u]) & 0xFFu;
+            packed |= ((v * 3u) >> 8u) << (8u * k);
+        }
+    }
+    buf_a[buf_ib].qs[iqs] = int32_t(packed);
+
+    if (iqs == 0) {
+        buf_a[buf_ib].dm = FLOAT_TYPE(data_a[block_idx].d);
+    }
+}
+
+void block_a_to_registers(const uint reg_ib, const uint buf_ib) {
+    cache_a[reg_ib].dm = buf_a[buf_ib].dm;
+
+    [[unroll]] for (uint iqs = 0; iqs < 8; ++iqs) {
+        cache_a[reg_ib].qs[iqs] = buf_a[buf_ib].qs[iqs];
+    }
+}
+
+ACC_TYPE mmq_dot_product(const uint ib_a) {
+    int32_t q_sum = 0;
+    [[unroll]] for (uint iqs = 0; iqs < 8; ++iqs) {
+        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[iqs], cache_b.qs[iqs]);
+    }
+
+    return ACC_TYPE(float(cache_a[ib_a].dm) * (float(q_sum) * float(cache_b.ds.x) - float(cache_b.ds.y)));
+}
