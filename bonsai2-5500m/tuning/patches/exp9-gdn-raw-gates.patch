+    uint raw_gates; // 1: beta and g are pre-activation: beta = sigmoid(beta), g = a[h] * softplus(g + dt_bias[h])
 };
 
 layout(binding = 0) readonly  buffer QBuf     { FLOAT_TYPE data_q[];     };
@@ -48,6 +49,8 @@ layout(binding = 7) readonly  buffer RowsBuf  { int data_rows[];         };
 // fused write-back: the cache row that receives the new state (may be the row the state was read from; every
 // invocation reads its own elements before it writes the same elements, so aliasing is safe for one sequence)
 layout(binding = 8)           buffer StateOutBuf { FLOAT_TYPE data_state_out[]; };
+layout(binding = 9)  readonly buffer DtBiasBuf { FLOAT_TYPE data_dt_bias[]; };
+layout(binding = 10) readonly buffer ABuf      { FLOAT_TYPE data_a[];       };
 
