+            FLOAT_TYPE g_log = FLOAT_TYPE(data_g[gb_off]);
+            if (raw_gates != 0u) {
+                const FLOAT_TYPE x = g_log + FLOAT_TYPE(data_dt_bias[head_id]);
+                g_log = FLOAT_TYPE(data_a[head_id]) * (x > FLOAT_TYPE(20.0) ? x : log(FLOAT_TYPE(1.0) + exp(x)));
+            }
+            const FLOAT_TYPE g_val = exp(g_log);
             [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                 g_exp[r] = g_val;
